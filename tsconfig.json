{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "moduleResolution": "bundler",

    "types": ["jest", "react", "expo-router"],

    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    },

    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "esModuleInterop": true
  },

  "include": ["**/*.ts", "**/*.tsx"]
}